HEALTH_PORT=8080
MTLS_PORT=8443
DEBUG=false
S3_BUCKET_NAME=
AWS_PROFILE=default
AWS_REGION=us-east-1
DATABASE_URL=postgres://user:password@localhost:5432/files?sslmode=verify-full&sslrootcert=certs/ca.pem
TLS_CERT_FILE=certs/file-service.pem
TLS_KEY_FILE=certs/file-service-key.pem
TLS_CA_CERT_FILE=certs/ca.pem
BROKER_URL=amqps://localhost:5671/file-uploader
BROKER_FILES_EXCHANGE=ex.files
BROKER_TLS_CERT_FILE=certs/rabbitmq-file-service.pem
BROKER_TLS_KEY_FILE=certs/rabbitmq-file-service-key.pem
BROKER_BATCH_SIZE=100
OTEL_COLLECTOR_URL=http://localhost:4317
OTEL_TRACE_SAMPLE_RATIO=1.0
GOOSE_DRIVER=postgres
GOOSE_DBSTRING=postgres://user:password@localhost:5432/files?sslmode=verify-full&sslrootcert=certs/ca.pem
GOOSE_MIGRATION_DIR=db/migrations
