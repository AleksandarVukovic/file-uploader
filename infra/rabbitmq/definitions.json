{
  "vhosts": [
    { "name": "file-uploader" }
  ],
  "users": [
    { "name": "file-service", "password_hash": "", "hashing_algorithm": "rabbit_password_hashing_sha256", "tags": "" },
    { "name": "file-processing-service", "password_hash": "", "hashing_algorithm": "rabbit_password_hashing_sha256", "tags": "" }
  ],
  "permissions": [
    { "user": "file-service", "vhost": "file-uploader", "configure": "", "write": "^ex\\.files$", "read": "" },
    { "user": "file-processing-service", "vhost": "file-uploader", "configure": "", "write": "", "read": "^q\\.file\\.uploaded$" }
  ],
  "exchanges": [
    { "name": "ex.files", "vhost": "file-uploader", "type": "topic", "durable": true, "auto_delete": false, "internal": false, "arguments": {} },
    { "name": "ex.files.dlx", "vhost": "file-uploader", "type": "fanout", "durable": true, "auto_delete": false, "internal": false, "arguments": {} }
  ],
  "queues": [
    { "name": "q.file.uploaded", "vhost": "file-uploader", "durable": true, "auto_delete": false, "arguments": { "x-queue-type": "quorum" } },
    { "name": "q.file.uploaded.dead", "vhost": "file-uploader", "durable": true, "auto_delete": false, "arguments": { "x-queue-type": "quorum" } }
  ],
  "bindings": [
    { "source": "ex.files", "vhost": "file-uploader", "destination": "q.file.uploaded", "destination_type": "queue", "routing_key": "file.uploaded", "arguments": {} },
    { "source": "ex.files.dlx", "vhost": "file-uploader", "destination": "q.file.uploaded.dead", "destination_type": "queue", "routing_key": "", "arguments": {} }
  ],
  "policies": [
    {
      "name": "p.file.uploaded.dead-lettering",
      "vhost": "file-uploader",
      "pattern": "^q\\.file\\.uploaded$",
      "apply-to": "queues",
      "priority": 0,
      "definition": {
        "dead-letter-exchange": "ex.files.dlx",
        "dead-letter-strategy": "at-least-once",
        "overflow": "reject-publish",
        "delivery-limit": 3
      }
    }
  ]
}
